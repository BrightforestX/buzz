# Copy to secrets.env (gitignored) and run: fly secrets import < secrets.env -a buzz-relay-pathx
# Or export individually: fly secrets set KEY=value -a buzz-relay-pathx
#
# Postgres + Redis: self-hosted on Railway (NOT Neon / NOT Upstash).
# Enable TCP Proxy on Railway postgres + redis services; paste proxy URLs below.
# See deploy/ARCHITECTURE.md and deploy/fly/README.md.

# --- Railway Postgres (TCP proxy from Fly — sslmode=require) ---
DATABASE_URL=postgresql://buzz:CHANGE_ME@containers-us-west-xxx.railway.app:PORT/buzz?sslmode=require

# --- Railway Redis (TCP proxy — use rediss:// when TLS enabled) ---
REDIS_URL=rediss://default:CHANGE_ME@containers-us-west-yyy.railway.app:PORT

# --- Relay identity ---
RELAY_URL=wss://relay.pathx.ai
RELAY_OWNER_PUBKEY=
BUZZ_RELAY_PRIVATE_KEY=
BUZZ_GIT_HOOK_HMAC_SECRET=

# --- Object storage (Fly Tigris, Cloudflare R2, or S3) ---
BUZZ_S3_ENDPOINT=https://fly.storage.tigris.dev
BUZZ_S3_ACCESS_KEY=
BUZZ_S3_SECRET_KEY=
BUZZ_S3_BUCKET=buzz-media
BUZZ_S3_REGION=auto
BUZZ_S3_ADDRESSING_STYLE=path

# --- Optional ---
# BUZZ_PUSH_ENABLED=false
# BUZZ_KLIPY_API_KEY=
